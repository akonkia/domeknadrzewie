#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

should_run="false"

if git diff --cached --name-only | grep -qE '^(assets/js/cards-data\.js|scripts/generate_urban_bathing_structured_data\.mjs)$'; then
  should_run="true"
fi

if git diff --name-only | grep -qE '^(assets/js/cards-data\.js|scripts/generate_urban_bathing_structured_data\.mjs)$'; then
  should_run="true"
fi

if [ "$should_run" != "true" ]; then
  exit 0
fi

echo "Updating urban bathing structured data..."
node scripts/generate_urban_bathing_structured_data.mjs
git add materialy/kapiele_miejskie/index.html en/materials/urban-bathing/index.html
